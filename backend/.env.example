# Copie para .env e ajuste se quiser. Tudo é opcional: sem .env valem os padrões abaixo.
DATABASE_URL=sqlite:///./galaxia.db
CORS_ORIGINS=*
MULTA_POR_DIA=3.5
DIAS_PLANO=30

# --- Autenticação ---
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem SECRET_KEY uma chave aleatória é criada a cada start (todo mundo precisa logar de novo).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Se preenchidos, o 1º administrador é criado automaticamente no start.
ADMIN_EMAIL=
ADMIN_SENHA=
